# ─────────────────────────────────────────────────────────────────────────────
# VoxDrop environment configuration
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Every value below is a placeholder.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Optional: overrides PORT for the API only (use when a process manager injects PORT for the web dev server).
API_PORT=
# Vite dev server port (development only). APP_URL must match it.
WEB_PORT=5173
# Public origin users load the app from (Vite dev server in development).
APP_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────────
# Production: a real PostgreSQL URL, e.g. postgres://user:pass@host:5432/voxdrop
# Development: `pglite://./data/pglite` runs real PostgreSQL (WASM) in-process,
# so no database server is needed. `pglite://memory` is used by the tests.
DATABASE_URL=pglite://./data/pglite

# ── Sessions / crypto ───────────────────────────────────────────────────────
# At least 32 random characters. Used to derive the token-encryption key and
# the IP-hash pepper. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── Kick (official API: https://docs.kick.com) ──────────────────────────────
# KICK_MODE=live uses the real Kick OAuth 2.1 + PKCE flow and webhooks.
# KICK_MODE=mock enables MockKickService — DEVELOPMENT ONLY, refused in production.
KICK_MODE=mock
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Must exactly match the redirect URI registered on your Kick app.
KICK_REDIRECT_URI=http://localhost:5173/auth/kick/callback
# Optional PEM override. Kick signs webhooks with RSA-SHA256; when empty the key is
# fetched from https://api.kick.com/public/v1/public-key and cached.
KICK_WEBHOOK_PUBLIC_KEY=
# Not used by Kick's official webhooks (they are RSA-signed, not HMAC). Kept for
# forward compatibility with the requested config surface; safe to leave empty.
KICK_WEBHOOK_SECRET=

# ── Storage ─────────────────────────────────────────────────────────────────
# `s3` = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
# `mock` = MockStorageService writing to ./data/uploads — DEVELOPMENT ONLY.
STORAGE_PROVIDER=mock
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional ClamAV daemon for malware scanning of uploads (clamd INSTREAM).
# When empty, uploads are still strictly validated/re-encoded but NOT AV-scanned.
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Text-to-speech (viewer name announcements) ─────────────────────────────
# `espeak` = eSpeak NG binary (recommended self-hosted, `apt install espeak-ng`)
# `sapi`   = Windows built-in voices via PowerShell (Windows hosts only)
# `google` = Google Cloud Text-to-Speech (needs TTS_GOOGLE_API_KEY)
# `none`   = announcements disabled platform-wide
# `mock`   = MockTtsService chime tones, no real words — DEVELOPMENT ONLY
TTS_PROVIDER=mock
TTS_GOOGLE_API_KEY=
TTS_ESPEAK_BIN=espeak-ng

# ── Payments ────────────────────────────────────────────────────────────────
# `stripe` = Stripe Checkout. `mock` = MockPaymentService — DEVELOPMENT ONLY.
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=usd

# Optional: community invite shown as "Join Discord" in the sidebar (https only). Hidden when empty.
DISCORD_INVITE_URL=
